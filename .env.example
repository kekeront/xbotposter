# Copy this file to .env.local and fill in the values.
# Never commit .env.local — it is gitignored.

# ─── Database (Supabase Postgres) ────────────────────────────────────────────
# Pooled connection (port 6543) — for the running app.
DATABASE_URL=postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Direct connection (port 5432) — for Drizzle migrations only.
DATABASE_DIRECT_URL=postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ─── Supabase publishables (browser-safe) ────────────────────────────────────
# Used by @supabase/ssr for Storage / Auth later. NEXT_PUBLIC_* values are
# inlined into the client bundle at build time.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ─── OpenAI (required from slice 1 onward) ───────────────────────────────────
OPENAI_API_KEY=

# Optional model overrides. Defaults match what's in src/lib/env.ts.
# LLM_CHEAP_MODEL=gpt-5-nano
# LLM_MID_MODEL=gpt-5-mini
# LLM_WRITER_MODEL=gpt-5-mini       # bump to gpt-5.4-mini for demo polish
# EMBEDDING_MODEL=text-embedding-3-small

# ─── X / Twitter API (required from slice 2 onward) ──────────────────────────
# User-context tokens. After enabling Read+Write on your X app, regenerate
# these tokens — old ones will not have write scope.
X_CONSUMER_KEY=
X_CONSUMER_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# ─── Cron auth (required from slice 3 onward) ────────────────────────────────
# Any long random string. Vercel Cron sends this as Authorization: Bearer <…>.
CRON_SECRET=

# ─── Spend cap ───────────────────────────────────────────────────────────────
# When today's combined OpenAI + X spend estimate exceeds this, /api/cron/*
# endpoints return 429 and skip the next scheduled run. Manual UI actions
# (compose / take / qrt / post) bypass the cap — they're opt-in.
# Default 2.00 USD/day = roughly $60/month max autonomous burn.
# MAX_DAILY_USD=2.00

# ─── Telegram bot (optional, mobile-first approve flow) ──────────────────────
# When all three are set, autonomous cron-generate pushes new drafts to your
# Telegram with [approve & ship] / [skip] inline buttons. One-swipe approval
# from your phone — no need to open the admin panel.
# Setup:
#   1. Talk to @BotFather → /newbot → save the token
#   2. Send any message to your bot, then visit
#      https://api.telegram.org/bot<TOKEN>/getUpdates to find your chat id
#   3. Pick any long random string for the webhook secret
#   4. After deploy, register the webhook (once):
#      curl "https://api.telegram.org/bot<TOKEN>/setWebhook?url=<APP_URL>/api/telegram/webhook?secret=<SECRET>"
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# Public URL of this deployment. Used by Telegram to deep-link to /queue.
NEXT_PUBLIC_APP_URL=
